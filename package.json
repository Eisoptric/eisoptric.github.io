{
  "name": "eisoptric-website",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build && vite build --ssr src/entry-server.ts --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "prettier --check . && eslint . && vue-tsc -b"
  },
  "dependencies": {
    "marked": "^15.0.12",
    "vue": "^3.5.41",
    "vue-router": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^16.5.0",
    "prettier": "^3.10.1",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.2.2",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.149.0"
  }
}

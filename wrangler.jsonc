// The site is static: `npm run build` prerenders every page into dist/, and the Worker only serves those files.
// With this file present, `wrangler deploy` uses it as it is instead of configuring the project by itself (which adds
// Cloudflare's Vite plugin, and that plugin breaks the SSR build the prerender step reads).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eisoptric-github-io",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./dist",
    // /about serves about.html, /zh serves zh.html or zh/index.html.
    "html_handling": "auto-trailing-slash",
    // A path with no page gets the prerendered 404.html with a 404 status.
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true }
}
